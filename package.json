{
  "name": "cube-creatures-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "validate-data": "tsx scripts/validate-data.ts",
    "cards:scrape": "tsx scripts/scrape-cards.ts",
    "cards:cache-images": "tsx scripts/cache-images.ts",
    "simulate": "node -e \"console.error('Simulation requires the M3 engine; not implemented in M1.'); process.exit(1)\""
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cheerio": "1.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
